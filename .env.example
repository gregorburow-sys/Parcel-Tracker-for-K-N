# Appwrite endpoint, e.g. https://cloud.appwrite.io/v1 or self-hosted https://appwrite.example.com/v1
NEXT_PUBLIC_API_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite project ID
NEXT_PUBLIC_PROJECT_ID=your-project-id

# Appwrite database + collection IDs
NEXT_PUBLIC_DATABASE_ID=your-database-id
NEXT_PUBLIC_PARCELS_ID=your-parcels-collection-id
NEXT_PUBLIC_PARCELEVENTS_ID=your-parcel-events-collection-id
