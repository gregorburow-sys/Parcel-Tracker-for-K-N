# Copy this file to `.env` and fill in the values for your local
# development environment. Do NOT commit `.env` — it is git-ignored.

# Appwrite endpoint, e.g. https://cloud.appwrite.io/v1 or http://localhost/v1
NEXT_PUBLIC_API_ENDPOINT=

# Appwrite database identifier (Database ID from the Appwrite console).
NEXT_PUBLIC_DATABASE_ID=

# Collection ID storing parcel documents.
NEXT_PUBLIC_PARCELS_ID=

# Collection ID storing per-parcel status events.
NEXT_PUBLIC_PARCELEVENTS_ID=

# Appwrite project ID.
NEXT_PUBLIC_PROJECT_ID=

# Optional — released version exposed by /api/health.
# NEXT_PUBLIC_APP_VERSION=0.1.0

# Optional — minimum log level for utils/logger.js on the server.
# One of: debug, info, warn, error.
# LOG_LEVEL=info
